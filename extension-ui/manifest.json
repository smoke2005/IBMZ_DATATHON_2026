
{
    "manifest_version": 3,
    "name": "Sentinel AI Web Protection",
    "version": "1.0.0",
    "description": "AI-powered website classification and safety warnings.",
    "permissions": [
      "webNavigation",
      "tabs",
      "storage"
    ],
    "host_permissions": [
      "http://127.0.0.1:8000/*",
      "http://localhost:8000/*",
      "http://*/*",
      "https://*/*"
    ],
    "background": {
      "service_worker": "background.js"
    },
    "action": {
      "default_title": "Sentinel AI"
    }
  }
  